#include <iostream>
#include "caiculate_sum.h"
using namespace std;
int main() 
{
    setlocale(LC_ALL, "Russian");
    int n;
    cout << "Введите значение n: ";
    while (true)
    {
        cin >> n;
        if (cin.fail() || n < 10) 
        {
            cin.ignore(10000000000000000000, '\n');//игнорировать некорректный ввод
            cout << "Ошибка: n должно быть больше или равно 10! " << endl;
            cout << "Введите значение n: ";
        }
        else 
        {
            break;//ввод корректен, выход из цикла
        }
    }
    int r = Sum(n);//переменная для результата итоговой суммы
    cout << "Сумма 1^" << n << " + 2^" << n << " + ... + " << n << "^" << n << " = " << r << endl;
    cout << "Программа завершена, нажмите пробел. ";
    return 0;
}
