int Sum(int n)
{
    int s = 0;//хранение и инициализация суммы
    for (int i = 1; i <= n; i++)
    {
        int p = 1;//переменная для хранения i^n
        for (int j = 0; j < n; j++)
        {
            p *= i;//возведение в степень чисел
        }
        s += p;//добавление к сумме текущее значение
    }
    return s;
}
