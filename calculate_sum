#include <iostream>
using namespace std;
int Sum(int n) 
{
    int s = 0;//хранение и инициализация суммы
    for (int i = 1; i <= n; i++) 
    {
        int p = 1;//переменная для хранения степени чисел
        for (int j = 0; j < n; j++)
        {
            p *= i;//возведение в степень чисел
        }
        s += p;//добавление к сумме текущее значение
    }
    return s;
}
int main()
{
    setlocale(LC_ALL, "Russian");
    int n;
    cout << "Введите значение n: ";
    cin >> n;
    if (n < 10) 
    {
        cout << "n - больше или равно 10. " << endl;
        return 1;
    }
    int r = Sum(n);//результат полученной суммы
    cout << "Сумма 1^" << n << " + 2^" << n << " + ... + " << n << "^" << n << " = " << r << endl;
    cout << "Программа завершена, нажмите пробел. ";
    return 0;
}
